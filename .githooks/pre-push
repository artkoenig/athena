#!/usr/bin/env bash
# pre-push — refuses any push whose target is the default branch. The default
# branch advances only through a merged pull request (AGENTS.md, Bookkeeping).
# Self-contained on purpose: any repo can point core.hooksPath here.
# Sanctioned override: git push --no-verify.
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      branch="${remote_ref#refs/heads/}"
      echo "pre-push: refusing to push to '${branch}' — it advances only through a merged pull request." >&2
      exit 1
      ;;
  esac
done

exit 0
