node_modules/
*.log

# Personal Claude Code settings — this is where the telemetry env block belongs,
# so it never forces other contributors to export into a collector they don't run.
.claude/settings.local.json

# Where `claude --worktree` puts a parallel run's checkout. Without this line
# every worktree shows up as untracked in the main checkout.
.claude/worktrees/

# athena-observe persistence (--persist)
.athena-telemetry/
telemetry/

